node_modules
.svelte-kit
build
# Array and MEG Honey font licences: do not publish those font files in a public repo.
# Junicode, Cormorant Garamond, National Park and Paper Mono are free to share
# (SIL Open Font License), so they go in.
static/fonts/*
!static/fonts/Junicode*.woff2
!static/fonts/CormorantGaramond*.woff2
!static/fonts/NationalPark*.woff2
!static/fonts/PaperMono*.woff2

# Local tooling: the impeccable design skill (with its Windows binary) and its review cache.
# Both are installed per machine, not part of the site.
.claude/skills/
.impeccable/
